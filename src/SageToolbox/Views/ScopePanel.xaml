<views:ToolPanel x:Class="SageToolbox.Views.ScopePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SageToolbox.Views">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel Margin="16">
            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,0,0,14" />

            <TextBlock Text="Portée" FontWeight="SemiBold" Margin="0,0,0,8" />
            <RadioButton x:Name="DatabaseRadio" GroupName="Scope" Margin="0,0,0,6" />
            <RadioButton x:Name="AllRadio" GroupName="Scope" Content="Toutes les bases Sage de l'instance" Margin="0,0,0,16" />

            <Button x:Name="RunButton" Style="{StaticResource ActionButton}" Height="34"
                    HorizontalContentAlignment="Center" Click="Run_Click" />
        </StackPanel>
    </Grid>
</views:ToolPanel>
