<views:ToolPanel x:Class="SageToolbox.Views.DevaliderFactureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SageToolbox.Views"
        Title="Dévalider des factures"
        MaxWidth="10000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <views:ToolPanel.Resources>
        <Style x:Key="FactureRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Hl" Background="{DynamicResource AccentBrush}" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.16" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </views:ToolPanel.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Filtres -->
        <WrapPanel Grid.Row="0" x:Name="FiltersPanel" Margin="0,0,0,10" PreviewKeyDown="Filters_PreviewKeyDown">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Date du" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                <TextBox x:Name="DateFromInput" Width="100" ToolTip="jj/mm/aaaa" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="au" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                <TextBox x:Name="DateToInput" Width="100" ToolTip="jj/mm/aaaa" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Client (n° ou intitulé)" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                <TextBox x:Name="ClientInput" Width="200" />
            </StackPanel>
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="N° de facture" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                <TextBox x:Name="PieceInput" Width="130" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Rechercher" Style="{StaticResource ActionButton}" Margin="0,0,6,0"
                        HorizontalContentAlignment="Center" Click="Search_Click" />
                <Button Content="Effacer" Style="{StaticResource SecondaryButton}" Margin="0"
                        HorizontalContentAlignment="Center" Click="ClearFilters_Click" />
            </StackPanel>
        </WrapPanel>

        <!-- Liste -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,8,18,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="SelectAllCheckBox" Grid.Column="0" HorizontalAlignment="Center"
                              ToolTip="Tout sélectionner" Click="SelectAll_Click" />
                    <TextBlock Grid.Column="1" Text="N° facture" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Date" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="N° client" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="4" Text="Intitulé client" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="5" Text="Montant HT" FontWeight="SemiBold" TextAlignment="Right" />
                </Grid>

                <ListBox x:Name="FacturesList" Grid.Row="1" Background="Transparent" BorderThickness="0,1,0,0"
                         BorderBrush="{DynamicResource CardBorderBrush}"
                         ItemContainerStyle="{StaticResource FactureRowStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="FacturesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,10,0" ToolTip="{Binding BlockReason}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="RowCheck" Grid.Column="0" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                <TextBlock x:Name="RowBlocked" Grid.Column="0" Text="&#xE7BA;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock Grid.Column="1" Text="{Binding DoPiece}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding DateLabel}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding CtNum}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding CtIntitule}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding TotalHtLabel}" TextAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                    <Setter TargetName="RowCheck" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="RowBlocked" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Motif de blocage de la ligne sélectionnée -->
        <Border x:Name="ReasonBanner" Grid.Row="2" Visibility="Collapsed" Margin="0,8,0,0" Padding="10,8"
                CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource DangerBrush}">
            <TextBlock x:Name="ReasonText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
        </Border>

        <!-- Pied -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" />
                <TextBlock x:Name="LimitText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="DevaliderButton" Grid.Column="1" Content="Dévalider la sélection"
                    Style="{StaticResource DangerButton}" Margin="0" Padding="18,8"
                    HorizontalContentAlignment="Center" IsEnabled="False" Click="Devalider_Click" />
        </Grid>
    </Grid>
</views:ToolPanel>
