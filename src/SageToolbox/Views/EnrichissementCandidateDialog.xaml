<Window x:Class="SageToolbox.Views.EnrichissementCandidateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sélection de l'entreprise" Height="520" Width="720" MinHeight="350" MinWidth="500"
        Icon="/Assets/SageToolbox.ico" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="10">
                <StackPanel>
                    <TextBlock Text="Données Sage d'origine" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock x:Name="SageInfoText" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent">
                <ItemsControl x:Name="CandidatesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="Candidates" Margin="0,5" Checked="Candidate_Checked" Tag="{Binding}">
                                <StackPanel Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding NomComplet}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Siret, StringFormat=' — SIRET {0}'}" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="State" Text="Actif" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding AdresseComplete, StringFormat=' — {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </RadioButton>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding EntrepriseActive}" Value="False">
                                    <Setter TargetName="State" Property="Text" Value="Radié" />
                                    <Setter TargetName="State" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0"
                        HorizontalContentAlignment="Center" Click="Cancel_Click" />
                <Button Content="Valider" Style="{StaticResource ActionButton}" Width="100" Margin="0"
                        HorizontalContentAlignment="Center" Click="Validate_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
