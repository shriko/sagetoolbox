<views:ToolPanel x:Class="SageToolbox.Views.ListingRfePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SageToolbox.Views"
        Title="Listing RFE — adresses de facturation électronique"
        MaxWidth="10000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <views:ToolPanel.Resources>
        <views:CountGreaterThanOneToVisibilityConverter x:Key="CountGreaterThanOneToVisibilityConverter" />
        <SolidColorBrush x:Key="ActifRowBrush" Color="#334CAF50" />
        <SolidColorBrush x:Key="InactifRowBrush" Color="#33F44336" />
        <Style x:Key="RfeRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Actif}" Value="Oui">
                    <Setter Property="Background" Value="{StaticResource ActifRowBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Actif}" Value="Non">
                    <Setter Property="Background" Value="{StaticResource InactifRowBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </views:ToolPanel.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Actions et filtres -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="12">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Actualiser" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                            HorizontalContentAlignment="Center" Click="Refresh_Click" />
                    <Button Content="Exporter Excel..." Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                            HorizontalContentAlignment="Center" Click="Export_Click" />
                    <Button x:Name="ColumnsButton" Content="Colonnes ▾" Style="{StaticResource SecondaryButton}" Margin="0"
                            HorizontalContentAlignment="Center" Click="Columns_Click" />
                    <Popup x:Name="ColumnsPopup" PlacementTarget="{Binding ElementName=ColumnsButton}" StaysOpen="False"
                           Placement="Bottom" AllowsTransparency="True">
                        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="Colonnes affichées" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <CheckBox x:Name="ChkRaison" Content="Raison sociale" IsChecked="True" Margin="0,2" Click="Columns_Changed" />
                                <CheckBox x:Name="ChkTel" Content="Téléphone" IsChecked="True" Margin="0,2" Click="Columns_Changed" />
                                <CheckBox x:Name="ChkEmail" Content="E-mail" IsChecked="True" Margin="0,2" Click="Columns_Changed" />
                                <CheckBox x:Name="ChkType" Content="Type Maille" IsChecked="True" Margin="0,2" Click="Columns_Changed" />
                                <CheckBox x:Name="ChkMaille" Content="Maille Adresse" IsChecked="True" Margin="0,2" Click="Columns_Changed" />
                                <CheckBox x:Name="ChkActif" Content="Actif" IsChecked="True" Margin="0,2" Click="Columns_Changed" />
                                <CheckBox x:Name="ChkNb" Content="Nb Adresses" IsChecked="True" Margin="0,2" Click="Columns_Changed" />
                                <CheckBox x:Name="ChkContact" Content="Contact" IsChecked="True" Margin="0,2" Click="Columns_Changed" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>

                <WrapPanel Margin="0,10,0,0">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Compte" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                        <TextBox x:Name="CompteFilter" Width="120" TextChanged="Filter_Changed" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Raison sociale" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                        <TextBox x:Name="RaisonFilter" Width="220" TextChanged="Filter_Changed" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Actif" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                        <ComboBox x:Name="ActifFilter" Width="100" SelectionChanged="Filter_Changed" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Type maille" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                        <ComboBox x:Name="TypeFilter" Width="180" SelectionChanged="Filter_Changed" />
                    </StackPanel>
                    <Button Content="Effacer les filtres" Style="{StaticResource SecondaryButton}" Margin="0" VerticalAlignment="Bottom"
                            HorizontalContentAlignment="Center" Click="ClearFilters_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Liste -->
        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  IsReadOnly="True" GridLinesVisibility="None" HeadersVisibility="Column" RowHeaderWidth="0"
                  Background="Transparent" BorderBrush="{DynamicResource CardBorderBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}" CellStyle="{StaticResource GridCellStyle}"
                  RowStyle="{StaticResource RfeRowStyle}">

            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.Panel>
                        <ItemsPanelTemplate>
                            <DataGridRowsPresenter />
                        </ItemsPanelTemplate>
                    </GroupStyle.Panel>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <StackPanel>
                                            <!-- Séparateur marqué : changement de tiers -->
                                            <Border Height="3" Background="{DynamicResource TextSecondaryBrush}" />
                                            <ItemsPresenter />
                                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,1" Padding="8,4"
                                                    Visibility="{Binding ItemCount, Converter={StaticResource CountGreaterThanOneToVisibilityConverter}}">
                                                <TextBlock FontWeight="SemiBold">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="Compte {0} — {1} adresses au total">
                                                            <Binding Path="Name" />
                                                            <Binding Path="ItemCount" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Compte" Binding="{Binding Compte}" Width="100" />
                <DataGridTextColumn x:Name="ColRaison" Header="Raison Sociale" Binding="{Binding RaisonSociale}" Width="230" />

                <DataGridTemplateColumn x:Name="ColTel" Header="Téléphone" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" Margin="4,0">
                                <Hyperlink Click="TelHyperlink_Click" Tag="{Binding Telephone}" Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding Telephone, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn x:Name="ColEmail" Header="E-mail" Width="230">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock VerticalAlignment="Center" Margin="4,0">
                                <Hyperlink Click="MailHyperlink_Click" Tag="{Binding Email}" Foreground="{DynamicResource AccentBrush}">
                                    <Run Text="{Binding Email, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn x:Name="ColType" Header="Type Maille" Binding="{Binding TypeMaille}" Width="140" />
                <DataGridTextColumn x:Name="ColMaille" Header="Maille Adresse" Binding="{Binding MailleAdresse}" Width="150" />
                <DataGridTextColumn x:Name="ColActif" Header="Actif" Binding="{Binding Actif}" Width="60" />
                <DataGridTextColumn x:Name="ColNb" Header="Nb Adresses" Binding="{Binding NbAdresses}" Width="100" />

                <DataGridTemplateColumn x:Name="ColContact" Header="Contact" Width="300">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Contacts}"
                                      SelectedItem="{Binding SelectedContact, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName" IsEnabled="{Binding HasContacts}"
                                      Margin="2" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Statut -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            <ProgressBar x:Name="BusyBar" Grid.Column="1" IsIndeterminate="True" Width="120" Height="8" Visibility="Collapsed" />
        </Grid>
    </Grid>
</views:ToolPanel>
