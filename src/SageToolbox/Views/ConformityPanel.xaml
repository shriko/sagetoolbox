<views:ToolPanel x:Class="SageToolbox.Views.ConformityPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SageToolbox.Views"
        Title="Conformité facture électronique"
        MaxWidth="10000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <views:ToolPanel.Resources>
        <Style x:Key="RuleRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </views:ToolPanel.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}" AllowDrop="True"
          DragOver="Panel_DragOver" Drop="Panel_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fichier et profil -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Déposez ici un fichier XML (UBL, CII, Factur-X ou CDAR) ou un PDF Factur-X, ou choisissez-le avec le bouton." />
                        <TextBlock x:Name="FileNameText" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Parcourir..." Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                            Width="110" HorizontalContentAlignment="Center" Click="Browse_Click" />
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MaxWidth="420" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Profil de contrôle" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ProfileCombo" Grid.Column="1" />
                    <Button x:Name="ValidateButton" Grid.Column="2" Content="Contrôler la conformité"
                            Style="{StaticResource ActionButton}" Margin="12,0,0,0" Padding="18,8"
                            HorizontalContentAlignment="Center" IsEnabled="False" Click="Validate_Click" />
                    <StackPanel Grid.Column="3" x:Name="BusyPanel" Orientation="Horizontal" Margin="14,0,0,0" Visibility="Collapsed"
                                VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="120" Height="8" Margin="0,0,10,0" />
                        <TextBlock Text="Contrôle en cours..." Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,10,0,0"
                           Foreground="{DynamicResource DangerBrush}" />
            </StackPanel>
        </Border>

        <!-- Synthèse -->
        <Border x:Name="SummaryBorder" Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="12"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BadgeText" Grid.Column="0" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                           Margin="0,0,18,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="DocumentText" TextWrapping="Wrap" />
                    <TextBlock x:Name="CountsText" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Points de vigilance -->
        <ScrollViewer Grid.Row="2" MaxHeight="170" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"
                      Background="Transparent">
            <ItemsControl x:Name="VigilanceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6"
                                BorderBrush="{DynamicResource WarningBrush}">
                            <StackPanel>
                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCritical}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Filtres -->
        <Grid x:Name="FilterBar" Grid.Row="3" Margin="0,0,0,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" />
                <TextBlock Text="Rechercher un identifiant de règle ou un mot-clé..." IsHitTestVisible="False" Margin="8,0,0,0"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ShowFailedCheck" Content="Non conformes" IsChecked="True" Margin="0,0,14,0" Click="Filter_Changed" />
                <CheckBox x:Name="ShowPassedCheck" Content="Conformes" Margin="0,0,14,0" Click="Filter_Changed" />
                <CheckBox x:Name="ShowNaCheck" Content="Non applicables" Click="Filter_Changed" />
            </StackPanel>
        </Grid>

        <!-- Règles -->
        <Grid Grid.Row="4">
            <ListBox x:Name="RulesList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource RuleRowStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Style="{StaticResource CardBorder}" Margin="0,0,0,6" Padding="10,8"
                                MouseLeftButtonDown="Rule_Click" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Icon" Grid.Column="0" Text="{Binding StatusIcon}" FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Id}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                        <Border x:Name="FlagBadge" Visibility="Collapsed" CornerRadius="3" Padding="5,0" Margin="0,0,8,0"
                                                Background="{DynamicResource WarningBrush}">
                                            <TextBlock Text="{Binding FlagLabel}" FontSize="11" Foreground="#18181B" />
                                        </Border>
                                        <TextBlock Text="{Binding Ruleset}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding Occurrences}" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <StackPanel x:Name="Detail" Visibility="Collapsed" Margin="0,8,0,0">
                                        <TextBlock Text="Contexte XPath :" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Context}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,6" />
                                        <TextBlock Text="Test :" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Test}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,6" />
                                        <TextBlock x:Name="FailuresTitle" Text="Détail des erreurs :" FontWeight="SemiBold" FontSize="12"
                                                   Visibility="Collapsed" />
                                        <TextBlock x:Name="FailuresText" Text="{Binding FailuresText}" TextWrapping="Wrap" FontSize="12"
                                                   Margin="0,2,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock x:Name="Chevron" Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Top" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="failed">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                <Setter TargetName="FlagBadge" Property="Visibility" Value="Visible" />
                                <Setter TargetName="FailuresTitle" Property="Visibility" Value="Visible" />
                                <Setter TargetName="FailuresText" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="passed">
                                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFatal}" Value="True">
                                <Setter TargetName="FlagBadge" Property="Background" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="Detail" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" VerticalAlignment="Top" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,24,0,0"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>
    </Grid>
</views:ToolPanel>
