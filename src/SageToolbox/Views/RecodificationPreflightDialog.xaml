<Window x:Class="SageToolbox.Views.RecodificationPreflightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contrôles préalables" Width="640" SizeToContent="Height" MaxHeight="800"
        Icon="/Assets/SageToolbox.ico" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <StackPanel Margin="20">
            <TextBlock x:Name="Intro" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,14" />

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="12">
                <StackPanel>
                    <TextBlock x:Name="UsersTitle" Text="1. Aucun utilisateur sur la base" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="UsersStatus" TextWrapping="Wrap" />
                    <CheckBox x:Name="UsersConfirm" Margin="0,8,0,0" Visibility="Collapsed"
                              Checked="Confirm_Changed" Unchecked="Confirm_Changed" />
                    <Button x:Name="RecheckUsersButton" Content="Revérifier" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                            Margin="0,8,0,0" Padding="10,4" Click="Recheck_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="12">
                <StackPanel>
                    <TextBlock Text="2. Sauvegarde de la base" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock x:Name="BackupStatus" TextWrapping="Wrap" />
                    <StackPanel x:Name="BackupPanel">
                        <TextBlock Text="Chemin du fichier .bak (sur le serveur SQL) :" Margin="0,10,0,2" />
                        <TextBox x:Name="BackupPath" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="BackupButton" Content="Sauvegarder maintenant" Style="{StaticResource SecondaryButton}"
                                    Margin="0" Padding="10,4" Click="Backup_Click" />
                            <Button Content="Revérifier" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="10,4"
                                    Click="Recheck_Click" />
                        </StackPanel>
                    </StackPanel>
                    <CheckBox x:Name="BackupConfirm" Margin="0,8,0,0" Visibility="Collapsed"
                              Checked="Confirm_Changed" Unchecked="Confirm_Changed" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="Message" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RunButton" Content="Lancer le traitement" Style="{StaticResource DangerButton}" Margin="0" Padding="16,8"
                        IsEnabled="False" IsDefault="True" Click="Run_Click" />
                <Button Content="Annuler" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="16,8" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
