<views:ToolPanel x:Class="SageToolbox.Views.RecodificationPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SageToolbox.Views"
        Title="Recodification (bêta)"
        MaxWidth="10000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Choix de l'élément, filtre et actions -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="12">
            <StackPanel>
                <TextBlock x:Name="DossierText" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Élément à recodifier" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                        <ComboBox x:Name="KindCombo" Width="220" SelectionChanged="Kind_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Filtrer" Style="{StaticResource SectionLabel}" Margin="0,0,0,2" />
                        <TextBox x:Name="FilterBox" MaxWidth="320" HorizontalAlignment="Left" Width="260" TextChanged="Filter_Changed" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button x:Name="ExportButton" Content="Exporter Excel" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                Padding="12,8" HorizontalContentAlignment="Center" IsEnabled="False" Click="Export_Click" />
                        <Button x:Name="ImportButton" Content="Importer Excel" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                                Padding="12,8" HorizontalContentAlignment="Center" IsEnabled="False" Click="Import_Click" />
                        <Button x:Name="ApplyButton" Content="Appliquer…" Style="{StaticResource DangerButton}" Margin="0"
                                Padding="18,8" HorizontalContentAlignment="Center" IsEnabled="False" Click="Apply_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Fiches : le nouveau code se saisit dans la grille -->
        <DataGrid x:Name="ItemsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionUnit="CellOrRowHeader" GridLinesVisibility="None" HeadersVisibility="Column" RowHeaderWidth="0"
                  Background="Transparent" RowBackground="Transparent" BorderBrush="{DynamicResource CardBorderBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}" EnableRowVirtualization="True"
                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}" CellStyle="{StaticResource GridCellStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="PlanColumn" Header="Plan" Binding="{Binding Plan}" IsReadOnly="True" Width="60" />
                <DataGridTextColumn Header="Code actuel" Binding="{Binding Code}" IsReadOnly="True" Width="170" />
                <DataGridTextColumn Header="Intitulé" Binding="{Binding Label}" IsReadOnly="True" Width="*" />
                <DataGridTextColumn Header="Nouveau code" Binding="{Binding NewCode, UpdateSourceTrigger=LostFocus}" Width="180" />
                <DataGridTextColumn Header="Contrôle" Binding="{Binding Message}" IsReadOnly="True" Width="320">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Statut -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Sélectionnez un élément à recodifier." />
            <ProgressBar x:Name="BusyBar" Grid.Column="1" IsIndeterminate="True" Width="120" Height="8" Visibility="Collapsed" />
        </Grid>
    </Grid>
</views:ToolPanel>
