<Window x:Class="SageToolbox.Views.CreateInfoLibreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Créer une Information Libre"
        Icon="/Assets/SageToolbox.ico"
        Height="420" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Topmost="True">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Table" Margin="0,0,0,6" />
            <ComboBox x:Name="TableCombo" Grid.Row="1" Margin="0,0,0,14" />

            <TextBlock Grid.Row="2" Text="Nom" Margin="0,0,0,6" />
            <TextBox x:Name="NameInput" Grid.Row="3" Margin="0,0,0,14" />

            <TextBlock Grid.Row="4" Text="Type" Margin="0,0,0,6" />
            <ComboBox x:Name="TypeCombo" Grid.Row="5" Margin="0,0,0,14"
                      SelectionChanged="TypeCombo_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Row="6" Text="Longueur (texte uniquement)" Margin="0,0,0,6" />
            <TextBox x:Name="LengthInput" Grid.Row="7" Margin="0,0,0,14" IsEnabled="False" />

            <Button Grid.Row="9" Content="Créer" Style="{StaticResource ActionButton}"
                    Height="34" HorizontalContentAlignment="Center" Click="Creer_Click" />
        </Grid>
    </Grid>
</Window>
