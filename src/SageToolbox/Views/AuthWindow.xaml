<Window x:Class="SageToolbox.Views.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sage Toolbox"
        Icon="/Assets/SageToolbox.ico"
        Height="260" Width="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        WindowStyle="SingleBorderWindow">
    <!-- Fond posé sur un conteneur externe SANS marge : pour la toute première fenêtre de
         l'application (avant tout autre rendu), le style implicite Window/Background peut
         ne pas encore être résolu au premier affichage, laissant apparaître le blanc par
         défaut dans la marge. En peignant un élément qui occupe 100% de la fenêtre (pas de
         Margin dessus), le fond est garanti quel que soit ce timing. -->
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Sage Toolbox" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" Text="Mot de passe requis" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,16" />

            <PasswordBox x:Name="PasswordInput" Grid.Row="2" Height="32"
                         KeyDown="PasswordInput_KeyDown" />

            <TextBlock x:Name="ErrorText" Grid.Row="3" Foreground="{DynamicResource DangerBrush}"
                       FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

            <Button Grid.Row="5" Content="Valider" Style="{StaticResource ActionButton}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Height="34" Click="Validate_Click" />
        </Grid>
    </Grid>
</Window>
