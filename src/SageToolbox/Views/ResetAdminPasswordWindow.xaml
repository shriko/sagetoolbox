<Window x:Class="SageToolbox.Views.ResetAdminPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supprimer le mot de passe administrateur"
        Icon="/Assets/SageToolbox.ico"
        Height="420" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Topmost="True">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Réinitialise le mot de passe administrateur (compte &lt;Administrateur&gt;) sur tous les modules Sage installés sur la base connectée." />

            <TextBlock Grid.Row="1" Text="Désactiver également la gestion du mot de passe :" FontWeight="SemiBold" Margin="0,0,0,8" />

            <StackPanel Grid.Row="2" x:Name="OptionsPanel" />

            <Button Grid.Row="4" Content="Réinitialiser" Style="{StaticResource DangerButton}"
                    Height="34" HorizontalContentAlignment="Center" Click="Reinitialiser_Click" />
        </Grid>
    </Grid>
</Window>
