<views:ToolPanel x:Class="SageToolbox.Views.AuditTvaPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SageToolbox.Views"
        Title="Audit TVA"
        MaxWidth="10000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <views:ToolPanel.Resources>
        <Style x:Key="BaseRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Hl" Background="{DynamicResource AccentBrush}" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.08" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.16" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </views:ToolPanel.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Audit en lecture seule du paramétrage et de l'usage de la TVA sur les bases Sage Comptabilité de l'instance connectée (10 contrôles par base), avec génération d'un rapport Word, PDF et/ou Excel." />

        <!-- Bases -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,8">
                    <Button Content="Tout sélectionner" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                            HorizontalContentAlignment="Center" Click="SelectAll_Click" />
                    <Button Content="Tout désélectionner" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                            HorizontalContentAlignment="Center" Click="SelectNone_Click" />
                    <Button x:Name="RefreshButton" Content="Actualiser" Style="{StaticResource SecondaryButton}" Margin="0,0,14,0"
                            HorizontalContentAlignment="Center" Click="Refresh_Click" />
                    <TextBlock x:Name="CountText" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,18,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Base" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Société" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Taille (Mo)" FontWeight="SemiBold" TextAlignment="Right" />
                    <TextBlock Grid.Column="4" Text="Écritures N" FontWeight="SemiBold" TextAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="Écritures N-1" FontWeight="SemiBold" TextAlignment="Right" />
                </Grid>

                <ListBox x:Name="BasesList" Grid.Row="2" Background="Transparent" BorderThickness="0,1,0,0"
                         BorderBrush="{DynamicResource CardBorderBrush}"
                         ItemContainerStyle="{StaticResource BaseRowStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{Binding Selected, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{Binding Nom}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Societe}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding TailleLabel}" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding NbEcrituresNLabel}" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{Binding NbEcrituresN1Label}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Rapport -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="10">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Formats :" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox x:Name="WordCheck" Content="Word (.docx)" IsChecked="True" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="PdfCheck" Content="PDF" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="ExcelCheck" Content="Excel (.xlsx)" Margin="0,0,30,0" VerticalAlignment="Center" />
                    <RadioButton x:Name="SingleReportRadio" Content="Un seul rapport" IsChecked="True" GroupName="TvaMode"
                                 Margin="0,0,14,0" VerticalAlignment="Center" />
                    <RadioButton x:Name="PerBaseRadio" Content="Un rapport par base" GroupName="TvaMode" VerticalAlignment="Center" />
                </WrapPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Dossier de sortie :" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="OutputInput" Grid.Column="1" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="Parcourir..." Style="{StaticResource SecondaryButton}" Margin="0"
                            Width="100" HorizontalContentAlignment="Center" Click="Browse_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress" Height="14" Minimum="0" Maximum="1" VerticalAlignment="Center" />
            <Button x:Name="CancelButton" Grid.Column="1" Content="Annuler" Style="{StaticResource SecondaryButton}"
                    Margin="10,0,0,0" Padding="16,8" HorizontalContentAlignment="Center" IsEnabled="False" Click="Cancel_Click" />
            <Button x:Name="AnalyzeButton" Grid.Column="2" Content="Lancer l'analyse" Style="{StaticResource ActionButton}"
                    Margin="10,0,0,0" Padding="18,8" HorizontalContentAlignment="Center" IsEnabled="False" Click="Analyze_Click" />
        </Grid>
    </Grid>
</views:ToolPanel>
