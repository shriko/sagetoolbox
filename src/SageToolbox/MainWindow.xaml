<Window x:Class="SageToolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sage Toolbox"
        Icon="/Assets/SageToolbox.ico"
        Height="850" Width="1300"
        WindowStartupLocation="CenterScreen"
        MinHeight="650" MinWidth="1000">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Sage Toolbox" FontSize="18" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,0,0,2" />
                <TextBlock Grid.Row="1" Text="Administration Sage" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Info. Base en cours" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                                <TextBlock x:Name="DbNameText" Text="Aucune base connectée" TextWrapping="Wrap" FontSize="12" />
                                <TextBlock x:Name="DbProductsText" Text="" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                <TextBlock x:Name="DbSizeText" Text="" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                <TextBlock x:Name="DbPathText" Text="" TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Info. Instance SQL" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                                <TextBlock x:Name="InstanceNotConnectedText" Text="Non connecté" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="InstanceVersionText" Text="" TextWrapping="Wrap" FontSize="11" Visibility="Collapsed" />
                                <TextBlock x:Name="InstanceEditionText" Text="" TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="InstanceAuthText" Text="" TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="InstanceFilestreamText" Text="" TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="InstanceDataPathText" Text="" TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="InstanceLogPathText" Text="" TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="InstanceBackupPathText" Text="" TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="3">
                    <TextBlock Text="Thème" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                    <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="Système" />
                        <ComboBoxItem Content="Clair" />
                        <ComboBoxItem Content="Sombre" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Zone principale -->
        <Grid Grid.Column="1" Margin="16" Background="{DynamicResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="190" />
            </Grid.RowDefinitions>

            <!-- Barre de connexion -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Instance SQL" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="InstanceInput" Width="180" Margin="0,0,16,0" />
                    <TextBlock Text="Base de données" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="DatabaseInput" Width="180" Margin="0,0,16,0" />
                    <Button x:Name="ConnectButton" Content="Connecter" Style="{StaticResource ActionButton}"
                            Width="110" HorizontalContentAlignment="Center" Click="ConnectButton_Click" />
                    <Button x:Name="OpenMaeButton" Content="Ouvrir fichier local (.mae)" Style="{StaticResource SecondaryButton}"
                            Margin="10,0,0,0" HorizontalContentAlignment="Center" Click="OpenMaeButton_Click" />
                </StackPanel>
            </Border>

            <!-- Dashboard -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent">
                <StackPanel Background="Transparent">
                    <UniformGrid Columns="3" Rows="1">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="🔧 Maintenance (Base)" Style="{StaticResource CardTitle}" />
                                <Button x:Name="BtnOptimizeDb" Content="Optimiser la base" Style="{StaticResource ActionButton}" Click="BtnOptimizeDb_Click" />
                                <Button x:Name="BtnGenConnFiles" Content="Générer fichiers de connexion" Style="{StaticResource ActionButton}" Click="BtnGenConnFiles_Click" />
                                <Button x:Name="BtnListTriggers" Content="Lister triggers spécifiques" Style="{StaticResource ActionButton}" Click="BtnListTriggers_Click" />
                                <Button x:Name="BtnIntegrityCompta" Content="Contrôle d'intégrité comptable" Style="{StaticResource ActionButton}" Click="BtnIntegrityCompta_Click" />
                                <Button x:Name="BtnIntegrityCial" Content="Contrôle d'intégrité gestion co." Style="{StaticResource ActionButton}" Click="BtnIntegrityCial_Click" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="💳 Opérations (Base)" Style="{StaticResource CardTitle}" />
                                <Button x:Name="BtnDecloture" Content="Déclôture d'exercice" Style="{StaticResource ActionButton}" Click="BtnDecloture_Click" />
                                <Button x:Name="BtnDevaliderFacture" Content="Dévalider une facture" Style="{StaticResource ActionButton}" Click="BtnDevaliderFacture_Click" />
                                <Button x:Name="BtnCreerInfoLibre" Content="Créer Information Libre" Style="{StaticResource ActionButton}" Click="BtnCreerInfoLibre_Click" />
                                <Button x:Name="BtnCorrigerAdresses" Content="Corriger adresses livraison" Style="{StaticResource ActionButton}" Click="BtnCorrigerAdresses_Click" />
                                <Button x:Name="BtnCorrigerAccents" Content="Corriger les accents" Style="{StaticResource ActionButton}" Click="BtnCorrigerAccents_Click" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="🛡️ Administration (Base)" Style="{StaticResource CardTitle}" />
                                <Button x:Name="BtnResetAdminPwd" Content="Supprimer mot de passe admin" Style="{StaticResource DangerButton}" Click="BtnResetAdminPwd_Click" />
                                <Button x:Name="BtnPurgeGhosts" Content="Déconnexion users fantômes" Style="{StaticResource ActionButton}" Click="BtnPurgeGhosts_Click" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="⚙️ Serveur &amp; Instance" Style="{StaticResource CardTitle}" />
                            <UniformGrid Columns="3">
                                <Button x:Name="BtnOptimizeAll" Content="Optimiser TOUTES les bases" Style="{StaticResource ActionButton}" Height="36" Margin="4,4" Click="BtnOptimizeAll_Click" />
                                <Button x:Name="BtnGenAllConnFiles" Content="Générer TOUS les fichiers" Style="{StaticResource ActionButton}" Height="36" Margin="4,4" Click="BtnGenAllConnFiles_Click" />
                                <Button x:Name="BtnCopyUsers" Content="Copier les utilisateurs" Style="{StaticResource ActionButton}" Height="36" Margin="4,4" Click="BtnCopyUsers_Click" />
                                <Button x:Name="BtnRestoreSql" Content="Restauration SQL en lot" Style="{StaticResource ActionButton}" Height="36" Margin="4,4" Click="BtnRestoreSql_Click" />
                                <Button x:Name="BtnBackupAll" Content="Sauvegarder TOUTES les bases" Style="{StaticResource ActionButton}" Height="36" Margin="4,4" Click="BtnBackupAll_Click" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Console de log -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Background="{DynamicResource LogBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Journal" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" Background="Transparent">
                        <ItemsControl x:Name="LogItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Formatted}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource LogTextBrush}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
