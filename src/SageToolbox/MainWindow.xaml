<Window x:Class="SageToolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SageToolbox.Views"
        Title="Sage Toolbox"
        Icon="/Assets/SageToolbox.ico"
        Height="950" Width="1300"
        WindowStartupLocation="CenterScreen"
        MinHeight="650" MinWidth="1000">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Sage Toolbox" FontSize="18" FontWeight="Bold"
                           TextWrapping="Wrap" Margin="0,0,0,2" />
                <TextBlock Grid.Row="1" Text="Administration Sage" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />

                <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Connexion" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <RadioButton x:Name="ModeOnPremiseRadio" Content="Sage 100" GroupName="ConnectionMode" IsChecked="True"
                                         Margin="0,0,16,0" Checked="ConnectionMode_Changed"
                                         ToolTip="Sage 100 sur SQL Server : une base par dossier, authentification Windows" />
                            <RadioButton x:Name="ModeSpcRadio" Content="SPC (Azure)" GroupName="ConnectionMode"
                                         Checked="ConnectionMode_Changed"
                                         ToolTip="Sage Premium Cloud : serveur Azure SQL, authentification SQL, une société par schéma" />
                        </StackPanel>

                        <StackPanel x:Name="OnPremisePanel">
                            <TextBlock Text="Instance SQL" Style="{StaticResource SectionLabel}" />
                            <TextBox x:Name="InstanceInput" />
                            <TextBlock Text="Base de données" Style="{StaticResource SectionLabel}" />
                            <TextBox x:Name="DatabaseInput" />
                            <Button x:Name="ConnectButton" Content="Connecter" Style="{StaticResource ActionButton}"
                                    Margin="0,10,0,6" HorizontalContentAlignment="Center" Click="ConnectButton_Click" />
                            <Button x:Name="OpenMaeButton" Content="Ouvrir fichier local (.mae)" Style="{StaticResource SecondaryButton}"
                                    Margin="0" HorizontalContentAlignment="Center" Click="OpenMaeButton_Click" />
                        </StackPanel>

                        <StackPanel x:Name="SpcPanel" Visibility="Collapsed">
                            <TextBlock Text="Serveur Azure SQL" Style="{StaticResource SectionLabel}" />
                            <TextBox x:Name="SpcServerInput" ToolTip="Ex : monserveur.database.windows.net" />
                            <TextBlock Text="Base de données" Style="{StaticResource SectionLabel}" />
                            <TextBox x:Name="SpcDatabaseInput" />
                            <TextBlock Text="Utilisateur SQL" Style="{StaticResource SectionLabel}" />
                            <TextBox x:Name="SpcUserInput" />
                            <TextBlock Text="Mot de passe" Style="{StaticResource SectionLabel}" />
                            <PasswordBox x:Name="SpcPasswordBox" />
                            <Button x:Name="SpcDetectButton" Content="Détecter sur ce poste" Style="{StaticResource SecondaryButton}"
                                    Margin="0,10,0,0" HorizontalContentAlignment="Center" ToolTip="Retrouve le serveur, la base et le mot de passe SPC configurés par Sage 100 sur ce poste"
                                    Click="SpcDetectButton_Click" />
                            <Button x:Name="SpcConnectButton" Content="Connecter" Style="{StaticResource ActionButton}"
                                    Margin="0,6,0,0" HorizontalContentAlignment="Center" Click="SpcConnectButton_Click" />
                            <StackPanel x:Name="SpcCompanyPanel" Visibility="Collapsed">
                                <TextBlock Text="Société" Style="{StaticResource SectionLabel}" />
                                <ComboBox x:Name="SpcCompanyCombo" DisplayMemberPath="Name" SelectionChanged="SpcCompanyCombo_SelectionChanged" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Info. Base en cours" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                                <TextBlock x:Name="DbNameText" Text="Aucune base connectée" TextWrapping="Wrap" FontSize="12" />
                                <TextBlock x:Name="DbProductsText" Text="" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                <TextBlock x:Name="DbSizeText" Text="" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                <TextBlock x:Name="DbPathText" Text="" TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Info. Instance SQL" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                                <TextBlock x:Name="InstanceNotConnectedText" Text="Non connecté" TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock x:Name="InstanceVersionText" Text="" TextWrapping="Wrap" FontSize="11" Visibility="Collapsed" />
                                <TextBlock x:Name="InstanceEditionText" Text="" TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="InstanceAuthText" Text="" TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="InstanceFilestreamText" Text="" TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="InstanceDataPathText" Text="" TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="InstanceLogPathText" Text="" TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="InstanceBackupPathText" Text="" TextWrapping="Wrap" FontSize="10"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="4">
                    <TextBlock Text="Thème" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                    <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="Système" />
                        <ComboBoxItem Content="Clair" />
                        <ComboBoxItem Content="Sombre" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Zone principale -->
        <Grid Grid.Column="1" Margin="16" Background="{DynamicResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="190" />
            </Grid.RowDefinitions>

            <!-- Outils : tuiles par section -->
            <ScrollViewer x:Name="TilesScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" Background="Transparent">
                <StackPanel Background="Transparent">
                    <TextBlock Text="CONTRÔLE &amp; AUDIT" Style="{StaticResource TileSectionTitle}" />
                    <WrapPanel Margin="0,0,0,12">
                        <Button x:Name="BtnListTriggers" Tag="&#xE943;" Content="Triggers spécifiques" Style="{StaticResource TileButton}" Click="BtnListTriggers_Click" />
                        <Button x:Name="BtnIntegrityCompta" Tag="&#xE930;" Content="Intégrité comptable" Style="{StaticResource TileButton}" Click="BtnIntegrityCompta_Click" />
                        <Button x:Name="BtnIntegrityCial" Tag="&#xE73A;" Content="Intégrité gestion co." Style="{StaticResource TileButton}" Click="BtnIntegrityCial_Click" />
                        <Button x:Name="BtnAuditTva" Tag="&#xE1D0;" Content="Audit TVA" Style="{StaticResource TileButton}" views:Tile.InstanceScope="True" Click="BtnAuditTva_Click" />
                        <Button x:Name="BtnConformity" Tag="&#xE7C3;" Content="Conformité factures" Style="{StaticResource TileButton}" Click="BtnConformity_Click" />
                        <Button x:Name="BtnListingRfe" Tag="&#xE715;" Content="Listing RFE" Style="{StaticResource TileButton}" Click="BtnListingRfe_Click" />
                    </WrapPanel>
                    <TextBlock Text="CORRECTION DE DONNÉES" Style="{StaticResource TileSectionTitle}" />
                    <WrapPanel Margin="0,0,0,12">
                        <Button x:Name="BtnCorrigerAdresses" Tag="&#xE707;" Content="Corriger adresses livraison" Style="{StaticResource TileButton}" Click="BtnCorrigerAdresses_Click" />
                        <Button x:Name="BtnCorrigerAccents" Tag="&#xE8D2;" Content="Corriger les accents" Style="{StaticResource TileButton}" Click="BtnCorrigerAccents_Click" />
                        <Button x:Name="BtnDevaliderFacture" Tag="&#xE8A5;" Content="Dévalider une facture" Style="{StaticResource DangerTileButton}" Click="BtnDevaliderFacture_Click" />
                        <Button x:Name="BtnDecloture" Tag="&#xE785;" Content="Déclôture d'exercice" Style="{StaticResource DangerTileButton}" Click="BtnDecloture_Click" />
                        <Button x:Name="BtnCreerInfoLibre" Tag="&#xE710;" Content="Créer information libre" Style="{StaticResource TileButton}" Click="BtnCreerInfoLibre_Click" />
                        <Button x:Name="BtnEnrichissement" Tag="&#xE77B;" Content="Enrichissement tiers" Style="{StaticResource TileButton}" Click="BtnEnrichissement_Click" />
                        <Button x:Name="BtnRecodification" Tag="&#xE70F;" Content="Recodification" Style="{StaticResource DangerTileButton}" views:Tile.Beta="True" Click="BtnRecodification_Click" />
                    </WrapPanel>
                    <TextBlock Text="UTILISATEURS &amp; SÉCURITÉ" Style="{StaticResource TileSectionTitle}" />
                    <WrapPanel Margin="0,0,0,12">
                        <Button x:Name="BtnCopyUsers" Tag="&#xE716;" Content="Copier les utilisateurs" Style="{StaticResource TileButton}" views:Tile.InstanceScope="True" Click="BtnCopyUsers_Click" />
                        <Button x:Name="BtnResetAdminPwd" Tag="&#xE72E;" Content="Supprimer mot de passe admin" Style="{StaticResource DangerTileButton}" Click="BtnResetAdminPwd_Click" />
                        <Button x:Name="BtnPurgeGhosts" Tag="&#xE7E8;" Content="Déconnexion users fantômes" Style="{StaticResource TileButton}" Click="BtnPurgeGhosts_Click" />
                    </WrapPanel>
                    <TextBlock Text="SAUVEGARDE &amp; RESTAURATION" Style="{StaticResource TileSectionTitle}" />
                    <WrapPanel Margin="0,0,0,12">
                        <Button x:Name="BtnBackupAll" Tag="&#xE74E;" Content="Sauvegarder toutes les bases" Style="{StaticResource TileButton}" views:Tile.InstanceScope="True" Click="BtnBackupAll_Click" />
                        <Button x:Name="BtnRestoreSql" Tag="&#xE777;" Content="Restauration SQL en lot" Style="{StaticResource DangerTileButton}" views:Tile.InstanceScope="True" Click="BtnRestoreSql_Click" />
                    </WrapPanel>
                    <TextBlock Text="MAINTENANCE TECHNIQUE" Style="{StaticResource TileSectionTitle}" />
                    <WrapPanel Margin="0,0,0,12">
                        <Button x:Name="BtnOptimize" Tag="&#xE945;" Content="Optimiser" Style="{StaticResource TileButton}" views:Tile.InstanceScope="True" Click="BtnOptimize_Click" />
                        <Button x:Name="BtnGenConnFiles" Tag="&#xE71B;" Content="Fichiers de connexion" Style="{StaticResource TileButton}" views:Tile.InstanceScope="True" Click="BtnGenConnFiles_Click" />
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Outil ouvert : remplace la grille de tuiles -->
            <Grid x:Name="ToolHost" Grid.Row="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Content="←  Retour" Style="{StaticResource SecondaryButton}" Margin="0,0,14,0"
                            IsEnabled="{Binding Content.IsEnabled, ElementName=ToolContent}" Click="BackButton_Click" />
                    <TextBlock x:Name="ToolHostTitle" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <ContentControl x:Name="ToolContent" Grid.Row="1" />
            </Grid>

            <!-- Console de log -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,12,0,0" Background="{DynamicResource LogBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Journal" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" Background="Transparent">
                        <ItemsControl x:Name="LogItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Formatted}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource LogTextBrush}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
