<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SageToolbox</AssemblyName>
    <RootNamespace>SageToolbox</RootNamespace>
    <ApplicationIcon>Assets\SageToolbox.ico</ApplicationIcon>
    <Version>1.3.0</Version>
    <Product>Sage Toolbox</Product>
    <AssemblyTitle>Sage Toolbox</AssemblyTitle>

    <!-- Packaging en exécutable autonome (self-contained), un seul fichier -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="PdfPig" Version="0.1.14" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="SaxonCS-HE" Version="13.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SageToolbox.ico" />
  </ItemGroup>

  <!-- Règles France_RFE (FNFE) 1.4.0.04 embarquées pour le contrôle de conformité des factures électroniques -->
  <ItemGroup>
    <EmbeddedResource Include="Schematron\fnfe_rules.zip" LogicalName="fnfe_rules.zip" />
  </ItemGroup>

  <!-- Scripts de recodification (modèles d'UPDATE par type d'élément) -->
  <ItemGroup>
    <EmbeddedResource Include="Recodification\Sql\*.sql" LogicalName="Recodification.Sql.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
